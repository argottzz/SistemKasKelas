DB_PASSWORD=
DB_NAME=db_kas_kelas
JWT_SECRET=ganti_dengan_secret_acak_min_32_karakter
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
EXCEL_PATH=C:\\Users\\User\\Desktop\\KELAS 11\\Laporan Kas RPL 2 2627.xlsx
# Supabase (server tepercaya, service-role key HANYA di backend/.env yang tidak di-commit)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key_dari_dashboard_supabase
# Produksi (Railway): NODE_ENV=production agar cookie lintas-situs (SameSite=None; Secure) aktif.
# Di Railway isi Variables: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET,
# FRONTEND_URL=https://ALAMAT-NETLIFY-KAMU, NODE_ENV=production. PORT otomatis dari Railway.
# EXCEL_PATH dan kredensial DB_HOST/DB_* hanya untuk lokal/MySQL lama, tidak dipakai di Railway.
NODE_ENV=development
