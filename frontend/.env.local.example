# Contoh untuk lokal. Di Vercel, isi via Project Settings → Environment variables.
# Browser + server (wajib untuk login Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_dengan_anon_public_key_dari_dashboard_supabase
# Server saja (jangan pakai prefix NEXT_PUBLIC_). Email bendahara, pisah koma.
# Hanya email ini yang bisa membuka dashboard + API. Kosong = tolak semua.
BENDAHARA_EMAILS=argazanuar1@gmail.com
